# ─────────────────────────────────────────────────────────────
# Instant Mail — environment template. Copy to `.env` and fill.
# NEVER commit the populated `.env`.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Local dev uses a user-space Postgres cluster (see scripts/db.sh)
DATABASE_URL="postgresql://instantmail:instantmail@localhost:5433/instantmail?schema=public"
# Direct (non-pooled) connection, used by Prisma Migrate in prod
DIRECT_DATABASE_URL=""

# ── App ─────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Auth / sessions ─────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=""

# ── Credential encryption (OAuth refresh tokens at rest) ────
# 32-byte key, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=""
# Optional previous key to support rotation (decrypt-only)
ENCRYPTION_KEY_PREVIOUS=""

# ── Google / Gmail OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"
# Shared secret validating Gmail push (Pub/Sub) notifications
GMAIL_PUBSUB_VERIFICATION_TOKEN=""
GMAIL_PUBSUB_TOPIC=""

# ── Microsoft / Outlook OAuth (Phase 11) ────────────────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/oauth/microsoft/callback"

# ── AI provider ─────────────────────────────────────────────
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# ── Background worker ───────────────────────────────────────
# Shared secret required by the worker tick endpoint / cron trigger
WORKER_AUTH_TOKEN=""
WORKER_CONCURRENCY="4"

# ── Observability (optional) ────────────────────────────────
LOG_LEVEL="info"
